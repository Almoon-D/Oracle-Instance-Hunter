# =============================================================================
#  hunt.config -- the dashboard.
#
#  This file is the ONE place to change what the hunter asks Oracle for.
#  Everything below is a plain shell assignment: edit the value between the
#  quotes, commit, and the next run uses it. No other file needs touching.
#
#  Precedence, highest first:
#    1. An environment variable set on the workflow step (one-off override)
#    2. This file
#    3. The built-in default in scripts/hunt.sh
#
#  After editing, check it offline with:   bash tests/test_hunt.sh
# =============================================================================


# -----------------------------------------------------------------------------
#  1. WHAT TO HUNT FOR
# -----------------------------------------------------------------------------
#
#  PRESETS -- to switch machine, comment out the ACTIVE block and uncomment one
#  of the others. Each block sets four values that must agree with each other.
#
#  ......................................................................
#  PRESET B: the full Always Free Ampere allowance, 2 OCPU / 12 GB, as a
#  single machine. Harder to win than 1 OCPU, because Oracle has to find one
#  host with room for the whole thing.
#
#     SHAPE="VM.Standard.A1.Flex"
#     SHAPE_IS_FLEX="true"
#     OCPU_LADDER="2 1"
#     GB_PER_OCPU="6"
#     STOP_AT_TOTAL_OCPUS="2"
#
#  ("2 1" means: ask for 2 OCPU at each placement, and if the tenancy's own
#  service limit refuses that size, fall back to 1 rather than give up.)
#
#  ......................................................................
#  PRESET C: the AMD micro box, VM.Standard.E2.1.Micro. Always Free gives you
#  two of these and they are almost always available -- there is nothing to
#  hunt for, but the same script will launch one. It is NOT a flex shape, so
#  the OCPU/memory numbers are fixed by Oracle and MEMORY_GB is set directly.
#
#     SHAPE="VM.Standard.E2.1.Micro"
#     SHAPE_IS_FLEX="false"
#     OCPU_LADDER="1"
#     MEMORY_GB="1"
#     STOP_AT_TOTAL_OCPUS="2"
#     OS_NAME="Canonical Ubuntu"
#     LIMIT_CORE_NAME=""          # no standard-a1-* limit applies to E2
#     LIMIT_MEMORY_NAME=""
#
#  ......................................................................

# --- PRESET A: one small Ampere box (ACTIVE) ---------------------------------

# The Oracle shape to launch. "Flex" shapes let you choose the OCPU and memory
# numbers; fixed shapes do not.
SHAPE="VM.Standard.A1.Flex"

# Does SHAPE take a --shape-config (OCPU/memory) argument? True for any name
# ending in .Flex, false for fixed shapes like VM.Standard.E2.1.Micro.
# Sending a shape-config to a fixed shape is rejected by Oracle.
SHAPE_IS_FLEX="true"

# Sizes to try at each placement, largest first, space-separated.
# "1"    -> only ever ask for a 1 OCPU machine.
# "2 1"  -> ask for 2, and settle for 1 if the tenancy's limit refuses 2.
OCPU_LADDER="1"

# Memory per OCPU. The Always Free tier fixes Ampere A1 at 6 GB per OCPU,
# so 1 OCPU = 6 GB and 2 OCPU = 12 GB. Do not raise this on a free tenancy:
# Oracle will refuse the request as over the memory service limit.
GB_PER_OCPU="6"

# Absolute memory in GB, for fixed (non-flex) shapes. Leave empty on a flex
# shape, where memory is computed as OCPUs x GB_PER_OCPU instead.
MEMORY_GB=""

# Boot volume size in GB. 50 is Oracle's minimum for these images. The Always
# Free tier includes 200 GB of block storage in total across all volumes.
BOOT_VOLUME_GB="50"

# The image to boot. OS_NAME/OS_VERSION are matched against Oracle's image
# catalogue; the newest matching aarch64 (non-Minimal) image is used.
# Other valid pairs: "Oracle Linux" / "9", "Canonical Ubuntu" / "22.04".
OS_NAME="Canonical Ubuntu"
OS_VERSION="24.04"

# What the instance is called in the OCI console once it is captured.
DISPLAY_NAME="ObliskIQ-lite"


# -----------------------------------------------------------------------------
#  2. WHEN TO STOP
# -----------------------------------------------------------------------------

# Stop hunting once the compartment already holds this many OCPUs of SHAPE.
# This is the guard that keeps a successful hunt from rolling on into a second
# instance and out of the free tier into billing.
#
# With OCPU_LADDER="1" and STOP_AT_TOTAL_OCPUS="1": win one 1 OCPU / 6 GB
# machine and stop for good. Every later run exits in ~45 seconds without
# launching anything.
#
# Set it to "2" to keep hunting after the first win until you hold the full
# free Ampere allowance -- with OCPU_LADDER="1" that means two 1-OCPU machines,
# which are individually easier to win than one 2-OCPU machine.
#
# The tenancy's real service limits are read at startup and this is clamped
# down to them, so it can never ask for more than Oracle allows. As of
# 15 June 2026 the Always Free Ampere allowance is 2 OCPU / 12 GB in total
# (it was 4 OCPU / 24 GB before that date).
STOP_AT_TOTAL_OCPUS="1"


# -----------------------------------------------------------------------------
#  3. HOW HARD TO ASK
# -----------------------------------------------------------------------------

# Floor for seconds between launch attempts. This is a floor, not a fixed rate:
# the hunt raises its pace by half on every TooManyRequests and eases it back
# by a quarter on every clean answer, converging on what the tenancy tolerates.
#
# Asking faster is not the same as asking better. Every request Oracle answers
# with 429 is a capacity check you did NOT make, so the figure to maximise is
# capacity checks per hour, not attempts per hour.
#
# This has been measured on this tenancy and the floor barely matters: 45s gave
# 167 real checks in a 5h45m window, 75s gave 164 in the same span -- about 28
# to 30 an hour either way, because the adaptive backoff converges on the rate
# Oracle sustains whichever floor it starts from. Changing this is unlikely to
# help. See "Measuring the pace floor" in the README for the full comparison.
INTERVAL="75"

# Random 0..JITTER-1 seconds added to every wait, so two hunters never land on
# the same second.
JITTER="5"

# Never back off further than this many seconds between attempts, however many
# 429s arrive. Above this the run is spending its window waiting rather than
# asking.
PACE_CEILING="300"

# Give up after this many consecutive errors the classifier does not recognise.
# Guards against burning a 6-hour window on a failure mode nobody anticipated.
MAX_UNKNOWN="5"


# -----------------------------------------------------------------------------
#  4. WHERE TO ASK
# -----------------------------------------------------------------------------

# Rotate through each fault domain within each availability domain, pinning
# every launch to one specific fault domain.
#
# Leave this "false". Oracle's own documented workaround for "Out of host
# capacity" is to create the instance WITHOUT specifying a fault domain:
# naming FD-1 asks for a host from that one bucket, while omitting it asks
# Oracle for any eligible host anywhere in the availability domain. Omitting
# is a strict superset, so every request covers more ground for the same
# API call.
#
# Set "true" only to experiment; it triples the number of placements and
# narrows each one.
ROTATE_FAULT_DOMAINS="false"

# Availability domains are always discovered automatically and all of them are
# rotated through -- there is nothing to configure here.


# -----------------------------------------------------------------------------
#  5. SERVICE LIMITS
# -----------------------------------------------------------------------------

# The names of the tenancy service limits that govern SHAPE. They are read
# before hunting starts so the request is shrunk to fit rather than spending
# attempts discovering it is too big.
#
# These names are Ampere-specific. Leave BOTH empty for a shape they do not
# apply to (an E2 micro, say); the limits pre-flight is then skipped and only
# STOP_AT_TOTAL_OCPUS bounds the request.
LIMIT_CORE_NAME="standard-a1-core-count"
LIMIT_MEMORY_NAME="standard-a1-memory-count"


# -----------------------------------------------------------------------------
#  6. EXPERIMENTAL
# -----------------------------------------------------------------------------

# Ask Oracle's CreateComputeCapacityReport what it thinks of each availability
# domain before launching into it.
#
# ADVISORY ONLY, and deliberately so. When this is "true" the report is used
# purely to decide which availability domain to TRY FIRST, and the run logs
# what the report said next to what the launch actually did. It never skips a
# launch attempt, because the report is not trustworthy enough to act on:
# oracle/oci-cli issue #748 documents it reporting AVAILABLE for an AD where
# A1 launches failed and OUT_OF_HOST_CAPACITY for one where they succeeded.
# Gating launches on it would mean skipping the domain that would have won.
#
# Turn it on for a few runs to see whether it agrees with reality in YOUR
# region, then decide. The report needs the tenancy (root) compartment, so
# OCI_TENANCY_OCID must be set for it to work.
CAPACITY_REPORT="false"
